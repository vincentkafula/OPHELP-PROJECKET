# Postgres connection string. On Railway, attach a PostgreSQL plugin to this
# service and it will inject DATABASE_URL automatically — you don't need to
# set this manually in production.
DATABASE_URL=postgresql://user:password@localhost:5432/ophelp

# Secret used to sign JWTs. Generate a real one for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the Express server listens on. Railway sets this automatically.
PORT=4000
